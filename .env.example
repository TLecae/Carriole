# Copier en `.env` et adapter. Le fichier `.env` n'est jamais versionné.
# L'application de bureau ne lit pas ce fichier : ses réglages sont dans %APPDATA%\Carriole\settings.json
# (voir docs/installation.md). Ces variables ne servent qu'à l'outillage du dépôt (inventaire, tests).

# Connexion PostgreSQL en lecture seule, utilisée par l'inventaire et la non-régression.
PG_CONN=host=HOTE port=5432 dbname=BASE user=UTILISATEUR password=MOT_DE_PASSE

# PostgreSQL de test (facultatif) : active les tests PostGIS de pytest et le scénario « connexions » de Playwright.
# ETL_TEST_PG=postgresql://utilisateur:motdepasse@hote:5432/base_de_test
# E2E_PG_HOST=hote
# E2E_PG_DB=base_de_test
# E2E_PG_USER=utilisateur
# E2E_PG_PASSWORD=motdepasse
