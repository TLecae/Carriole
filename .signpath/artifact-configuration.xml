<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration of the "carriole" project (a copy: SignPath keeps the active one).
     The Windows installer built by .github/workflows/release.yml, uploaded as a zip; the workflow passes the
     version read from desktop/package.json, and product name and version are enforced on the installer. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="Carriole-Setup-${version}.exe" product-name="Carriole" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
