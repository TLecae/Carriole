# Réglages de Carriole en mode serveur (docs/serveur.md). Copier ce fichier en carriole.env (non versionné : il
# contient un mot de passe), adapter les valeurs, puis, dans ce dossier : docker compose up -d
#
# Connexion par comptes locaux : au premier démarrage, le compte « admin » est créé avec ETL_ADMIN_PASSWORD ; il crée
# ensuite les autres comptes dans Outils → Comptes, et chacun change son mot de passe depuis son menu.

# --- premier administrateur (sans effet une fois un compte créé) ----------------------------------------------------
# Remplacer la valeur ci-dessous : le serveur refuse de démarrer avec elle (elle est publique).
ETL_ADMIN_USER=admin
ETL_ADMIN_PASSWORD=mot-de-passe-initial-a-changer
ETL_ADMINS=group:carriole-admins

# --- réseau ---------------------------------------------------------------------------------------------------------
# adresses du proxy HTTPS placé devant le port 8080 (réseau de Docker compris)
ETL_TRUSTED_PROXIES=127.0.0.1,172.16.0.0/12
# derrière HTTPS, si le proxy ne transmet pas X-Forwarded-Proto :
# ETL_SECURE_COOKIE=1

# --- fichiers : le dossier monté sur /mnt/donnees (CARRIOLE_DONNEES, voir compose.yaml) ------------------------------
ETL_READ_ROOTS=/mnt/donnees
ETL_WRITE_ROOTS=/mnt/donnees
ETL_ROOT_LABELS=/mnt/donnees=Données

# --- code Python des flux : deny, ou sandbox (bubblewrap, voir docs/serveur.md) -------------------------------------
ETL_USER_CODE=deny

# --- métadonnées dans PostgreSQL : COMPOSE_PROFILES=postgres dans .env, puis docker compose up -d -------------------
# POSTGRES_PASSWORD=mot-de-passe-de-la-base
# ETL_DB_URL=postgresql+psycopg://carriole:mot-de-passe-de-la-base@db/carriole
