# Carriole en mode serveur — identité par un proxy d'authentification (SSO, OpenID Connect…), docs/serveur.md.
# Le proxy identifie l'utilisateur et transmet son nom (et ses groupes) dans des en-têtes ; Carriole ne les croit que
# s'ils viennent d'une adresse de ETL_TRUSTED_PROXIES : le port 8080 ne doit être joignable que par ce proxy.
# Copier ce fichier en docker/carriole.env (non versionné), adapter les valeurs, puis, dans le dossier docker :
# docker compose up -d --build

# --- identité : proxy d'authentification ----------------------------------------------------------------------------
ETL_AUTH=proxy
ETL_TRUSTED_PROXIES=127.0.0.1,172.16.0.0/12
ETL_AUTH_HEADER=X-Forwarded-User
# groupes séparés par des virgules (facultatif)
ETL_AUTH_GROUPS_HEADER=X-Forwarded-Groups
# ETL_AUTH_DISPLAY_HEADER=X-Forwarded-Name     # nom affiché (facultatif)
ETL_ADMINS=group:carriole-admins
# ETL_SECURE_COOKIE=1

# --- fichiers : le dossier monté sur /mnt/donnees (CARRIOLE_DONNEES, voir compose.yaml) ------------------------------
ETL_READ_ROOTS=/mnt/donnees
ETL_WRITE_ROOTS=/mnt/donnees
ETL_ROOT_LABELS=/mnt/donnees=Données

# --- code Python des flux : sandbox (bubblewrap, voir docs/serveur.md) ou deny --------------------------------------
ETL_USER_CODE=deny

# --- métadonnées dans PostgreSQL : lancer avec  docker compose --profile postgres up -d -----------------------------
# POSTGRES_PASSWORD=mot-de-passe-de-la-base
# ETL_DB_URL=postgresql+psycopg://carriole:mot-de-passe-de-la-base@db/carriole
