# Carriole en mode serveur — identité par un annuaire LDAP (docs/serveur.md, ADR 0052).
# Copier ce fichier en docker/carriole.env (non versionné : il contient des mots de passe), adapter les valeurs,
# puis, dans le dossier docker : docker compose up -d --build

# --- identité : annuaire LDAP, puis comptes locaux (gérés dans Outils → Comptes) ------------------------------------
# ldap seul : seuls les comptes de l'annuaire ; ldap,file : aussi des comptes créés par l'administrateur dans Carriole
ETL_AUTH=ldap,file
ETL_LDAP_URL=ldaps://annuaire.exemple.org:636
# ETL_LDAP_STARTTLS=1                      # avec une adresse ldap:// : chiffre la connexion
# ETL_LDAP_CA_FILE=/chemin/autorite.pem    # autorité de certification de l'annuaire, si elle n'est pas publique
ETL_LDAP_BIND_DN=cn=service-carriole,ou=Services,dc=exemple,dc=org
ETL_LDAP_BIND_PASSWORD=mot-de-passe-du-compte-de-service
ETL_LDAP_USER_BASE=ou=People,dc=exemple,dc=org
ETL_LDAP_USER_FILTER=(uid={username})
# ETL_LDAP_USER_FILTER=(sAMAccountName={username})   # annuaire de type Active Directory
ETL_LDAP_DISPLAY_ATTRIBUTES=givenName,sn
ETL_LDAP_GROUP_BASE=ou=Groupes,dc=exemple,dc=org
# ETL_LDAP_GROUP_FILTER=(|(member={dn})(uniqueMember={dn})(memberUid={username}))   # valeur par défaut
ETL_LDAP_REQUIRED_GROUP=cn=carriole,ou=Groupes,dc=exemple,dc=org
# administrateurs : noms et groupes (de l'annuaire ou des comptes locaux)
ETL_ADMINS=group:carriole-admins
# premier démarrage : compte local « admin » (groupe carriole-admins), utile si l'annuaire ne répond pas encore
# ETL_ADMIN_PASSWORD=mot-de-passe-initial-a-changer

# --- réseau ---------------------------------------------------------------------------------------------------------
# adresses du proxy HTTPS placé devant le port 8080 (réseau de Docker compris)
ETL_TRUSTED_PROXIES=127.0.0.1,172.16.0.0/12
# ETL_SECURE_COOKIE=1                      # derrière HTTPS, si le proxy ne transmet pas X-Forwarded-Proto

# --- fichiers : le dossier monté sur /mnt/donnees (CARRIOLE_DONNEES, voir compose.yaml) ------------------------------
ETL_READ_ROOTS=/mnt/donnees
ETL_WRITE_ROOTS=/mnt/donnees
ETL_ROOT_LABELS=/mnt/donnees=Données

# --- code Python des flux : sandbox (bubblewrap, voir docs/serveur.md) ou deny --------------------------------------
ETL_USER_CODE=deny

# --- métadonnées dans PostgreSQL : lancer avec  docker compose --profile postgres up -d -----------------------------
# POSTGRES_PASSWORD=mot-de-passe-de-la-base
# ETL_DB_URL=postgresql+psycopg://carriole:mot-de-passe-de-la-base@db/carriole
